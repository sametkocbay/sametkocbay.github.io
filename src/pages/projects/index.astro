---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.listOrder - b.data.listOrder);
const tags = ['all', ...[...new Set(projects.flatMap((project) => project.data.tags))].sort()];
---

<BaseLayout
  title="Projects | Samet Kocbay"
  description="Research and engineering across scientific ML, PDE-based modeling, and computational physics."
>
  <Navbar active="projects" />
  <main class="container pb80">
    <header class="page-head">
      <p class="prompt">ls ./research --all | grep <span id="activeLabel" class="grep-arg">"*"</span></p>
      <h1 class="page-title">Projects</h1>
      <p class="page-sub sub-620">
        Research and engineering across scientific ML, PDE-based modeling, and computational physics.
      </p>
      <div class="filter-row">
        {tags.map((tag) => (
          <button class={`filter-btn${tag === 'all' ? ' active' : ''}`} data-filter={tag}>{tag}</button>
        ))}
      </div>
    </header>
    <div class="grid-3 projects-grid">
      {projects.map((project) => <ProjectCard project={project} variant="list" />)}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .grep-arg {
    color: var(--text);
  }
  .sub-620 {
    max-width: 620px;
  }
  .projects-grid {
    margin-top: 32px;
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-card]'));
  const label = document.getElementById('activeLabel');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.filter ?? 'all';
      buttons.forEach((b) => b.classList.toggle('active', b === button));
      if (label) label.textContent = tag === 'all' ? '"*"' : `"${tag}"`;
      cards.forEach((card) => {
        const cardTags = (card.dataset.tags ?? '').split(',');
        card.style.display = tag === 'all' || cardTags.includes(tag) ? '' : 'none';
      });
    });
  });
</script>
