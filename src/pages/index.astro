---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { siteData } from '../data/site';
import { techGroups } from '../data/tech';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { withBase } from '../utils/withBase';

const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const heroPhotos = [
  { fi: 0.16, fj: 0.3, src: withBase('/assets/Me_hiking.jpeg'), cap: '# snow hiking around the rotwand' },
  { fi: 0.38, fj: 0.62, src: withBase('/assets/grreece.jpeg'), cap: '# meeting my old friend sokrates on the akropolis' },
  { fi: 0.62, fj: 0.28, src: withBase('/assets/Cycling.jpeg'), cap: '# race finish with nathan in feltre, italy' },
  { fi: 0.84, fj: 0.55, src: withBase('/assets/FS_CZECH_Win.jpeg'), cap: '# celebrating our achievements in czech' }
];
---

<BaseLayout>
  <Navbar active="index" icons />

  <header class="hero">
    <canvas id="heroMesh"></canvas>
    <div id="heroPhotoTip" class="hero-tip">
      <img id="heroPhotoTipImg" src={withBase('/assets/Me_hiking.jpeg')} alt="Photo of Samet" />
      <p id="heroPhotoTipCap"># somewhere in the bavarian alps</p>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Samet Kocbay</h1>
        <p class="hero-sub">
          M.Sc. Computational Science &amp; Engineering @ TUM.<br />Physics-based simulation
          <span class="cyan">⇄</span> machine learning.
        </p>
        <div class="hero-pills">
          {siteData.heroPills.map((pill) => <span class="hero-pill">{pill}</span>)}
        </div>
        <div class="hero-ctas">
          <a href={withBase('/projects/')} class="btn-solid">./explore-research</a>
          <a href={withBase(siteData.cvPath)} class="btn-outline">cv.pdf</a>
        </div>
        <div class="hero-contact">
          <span>{siteData.location}</span>
          <a href={`mailto:${siteData.email}`}>{siteData.emailDisplay}</a>
          <a href={siteData.githubUrl}>github</a>
          <a href={siteData.linkedinUrl}>linkedin</a>
        </div>
      </div>
    </div>
    <span class="hero-note">graph: gravity sheet<br />cursor = heavy planet · <span class="red">red nodes = photos</span></span>
  </header>

  <main class="container">
    <section id="projects" class="section">
      <header class="sec-head">
        <div>
          <p class="prompt">ls ./research --featured</p>
          <h2 class="sec-title">Research highlights</h2>
        </div>
        <a href={withBase('/projects/')} class="sec-link">→ all projects</a>
      </header>
      <div class="grid-3">
        {projects.map((project) => <ProjectCard project={project} variant="home" />)}
      </div>
    </section>

    <section id="blog" class="section">
      <header class="sec-head">
        <div>
          <p class="prompt">tail -f blog.log</p>
          <h2 class="sec-title">Notes</h2>
        </div>
        <a href={withBase('/blog/')} class="sec-link">→ all posts</a>
      </header>
      <div class="notes-box">
        {posts.map((post) => (
          <a href={withBase(`/blog/${post.slug}/`)} class="note-row">
            <span class="note-date">{post.data.date}</span>
            <span class="note-title">{post.data.title}</span>
            <span class="note-tag">{post.data.tag}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="stack" class="section">
      <p class="prompt">cat /proc/skills</p>
      <h2 class="sec-title mb28">Tech stack</h2>
      <div class="skills-grid">
        {techGroups.map((group) => (
          <div class="skill-card">
            <p class="skill-path">{group.path}</p>
            <div class="skill-items">
              {group.items.map((item) => (
                <span class="skill-pill">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="experience" class="section">
      <div class="exp-grid">
        <div>
          <p class="prompt">git log --work</p>
          <h2 class="sec-title mb28">Experience</h2>
          <div class="timeline">
            {experience.map((entry) => (
              <div class="t-entry">
                <span class="t-dot" aria-hidden="true"></span>
                <p class="t-dates">{entry.dates}</p>
                <h3 class="t-company">{entry.company}</h3>
                <p class="t-role">{entry.roleLine}</p>
                <ul class="t-bullets">
                  {entry.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div id="education">
            <p class="prompt">git log --education</p>
            <h2 class="sec-title mb28">Education</h2>
            <div class="edu-list">
              {education.map((entry) => (
                <div class="edu-card">
                  <p class="edu-dates">{entry.dates}</p>
                  <h3 class="edu-degree">{entry.degree}</h3>
                  <p class="edu-school">{entry.school}</p>
                  <ul class="edu-highlights">
                    {entry.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
          <div class="personal">
            <p class="prompt">cat about/personal.yml</p>
            <h2 class="personal-title">Personal</h2>
            <div class="yaml-card">
              <p class="yaml-key">languages:</p>
              <p class="yaml-val">
                - german <span class="c"># native</span><br />- english <span class="c"># C1 · TOEFL 111/120</span><br />-
                turkish
              </p>
              <p class="yaml-key mt8">passions:</p>
              <p class="yaml-val">
                - olympic wrestling <span class="c"># 2× german national champion · multiple-time landesmeister</span
                ><br />- cycling<br />- hiking / climbing
              </p>
            </div>
            <figure class="photo">
              <div class="photo-frame">
                <img src={withBase('/assets/Me_hiking.jpeg')} alt="Samet hiking in the snowy Bavarian Alps" />
              </div>
              <figcaption># somewhere in the bavarian alps</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer showCv spaced />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 560px;
    border-bottom: 1px solid var(--border-cyan);
    overflow: hidden;
  }
  #heroMesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    width: 300px;
    border: 1px solid rgba(255, 107, 107, 0.5);
    border-radius: 6px;
    background: var(--card);
    padding: 8px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s, transform 0.18s;
    pointer-events: none;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }
  .hero-tip img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .hero-tip p {
    margin: 8px 2px 2px;
    font: 400 10.5px/1.5 var(--mono);
    color: var(--sec);
  }
  .hero-inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }
  .hero-copy {
    padding-bottom: 52px;
    animation: fadeUp 0.55s ease-out both;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: 66px;
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .hero-sub {
    margin: 14px 0 0;
    font: 400 15.5px/1.65 var(--mono);
    color: var(--sec);
    max-width: 640px;
  }
  .hero-sub .cyan {
    color: var(--cyan);
  }
  .hero-pills {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hero-pill {
    font: 400 11.5px var(--mono);
    color: var(--sec);
    border: 1px solid rgba(139, 147, 165, 0.3);
    border-radius: 4px;
    padding: 5px 10px;
    white-space: nowrap;
  }
  .hero-ctas {
    margin-top: 26px;
    display: flex;
    gap: 12px;
    pointer-events: auto;
  }
  .btn-solid {
    font: 500 12.5px var(--mono);
    background: var(--cyan);
    color: var(--bg);
    padding: 11px 20px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .btn-solid:hover {
    background: var(--cyan-h);
    color: var(--bg);
  }
  .btn-outline {
    font: 500 12.5px var(--mono);
    border: 1px solid rgba(139, 147, 165, 0.4);
    color: var(--text);
    padding: 11px 20px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .btn-outline:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .hero-contact {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font: 400 12px var(--mono);
    color: var(--muted);
    pointer-events: auto;
  }
  .hero-contact a {
    color: var(--muted);
  }
  .hero-contact a:hover {
    color: var(--cyan);
  }
  .hero-note {
    position: absolute;
    right: 40px;
    top: 26px;
    font: 400 10px var(--mono);
    color: rgba(139, 147, 165, 0.55);
    text-align: right;
    pointer-events: none;
  }
  .hero-note .red {
    color: rgba(255, 107, 107, 0.8);
  }

  .notes-box {
    border: 1px solid rgba(110, 231, 220, 0.25);
    border-radius: 6px;
    background: rgba(110, 231, 220, 0.03);
  }
  .note-row {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 18px 24px;
    border-bottom: 1px solid rgba(139, 147, 165, 0.15);
  }
  .note-row:hover {
    background: rgba(110, 231, 220, 0.05);
  }
  .note-date {
    font: 400 11.5px var(--mono);
    color: var(--muted);
    white-space: nowrap;
  }
  .note-title {
    font: 500 15px var(--sans);
    color: var(--text);
    flex: 1;
  }
  .note-tag {
    font: 400 11px var(--mono);
    color: var(--cyan);
    white-space: nowrap;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .skill-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    padding: 20px 24px;
  }
  .skill-path {
    margin: 0;
    font: 500 12px var(--mono);
    color: var(--cyan);
  }
  .skill-items {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skill-pill {
    font: 400 12px var(--mono);
    color: var(--sec);
    border: 1px solid rgba(139, 147, 165, 0.3);
    border-radius: 4px;
    padding: 5px 10px;
    transition: color 0.2s, border-color 0.2s;
  }
  .skill-pill:hover {
    color: var(--text);
    border-color: rgba(110, 231, 220, 0.5);
  }

  .exp-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
  }
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 1px;
    background: rgba(139, 147, 165, 0.25);
  }
  .t-entry {
    position: relative;
    padding: 0 0 32px 32px;
  }
  .t-dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--cyan);
    box-sizing: border-box;
  }
  .t-dates {
    margin: 0;
    font: 400 11px var(--mono);
    color: var(--muted);
  }
  .t-company {
    margin: 6px 0 0;
    font-size: 19px;
    font-weight: 600;
    color: var(--text);
  }
  .t-role {
    margin: 4px 0 0;
    font: 400 12px var(--mono);
    color: var(--cyan);
  }
  .t-bullets {
    margin: 12px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font: 400 13px/1.6 var(--mono);
    color: var(--sec);
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .edu-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    padding: 20px 24px;
  }
  .edu-dates {
    margin: 0;
    font: 400 11px var(--mono);
    color: var(--muted);
  }
  .edu-degree {
    margin: 6px 0 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }
  .edu-school {
    margin: 5px 0 0;
    font: 400 12px var(--mono);
    color: var(--cyan);
  }
  .edu-highlights {
    margin: 12px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 400 12.5px/1.6 var(--mono);
    color: var(--sec);
  }

  .personal {
    margin-top: 40px;
  }
  .personal-title {
    margin: 10px 0 20px;
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
  }
  .yaml-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    padding: 20px 24px;
    font: 400 12.5px/2 var(--mono);
  }
  .yaml-key {
    margin: 0;
    color: var(--muted);
  }
  .yaml-key.mt8 {
    margin-top: 8px;
  }
  .yaml-val {
    margin: 0;
    color: var(--sec);
    padding-left: 16px;
  }
  .yaml-val .c {
    color: var(--muted);
  }
  figure.photo {
    margin: 16px 0 0;
  }
  .photo-frame {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--inset);
  }
  .photo-frame img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    object-position: 50% 72%;
    display: block;
  }
  figure.photo figcaption {
    margin-top: 8px;
    font: 400 11px var(--mono);
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .exp-grid,
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy h1 {
      font-size: 48px;
    }
  }
  @media (max-width: 720px) {
    .hero-copy h1 {
      font-size: 42px;
    }
    .hero-note {
      right: 24px;
    }
  }
</style>

<script define:vars={{ photoData: heroPhotos }}>
  const cv = document.getElementById('heroMesh');
  const tip = document.getElementById('heroPhotoTip');
  const tipImg = document.getElementById('heroPhotoTipImg');
  const tipCap = document.getElementById('heroPhotoTipCap');
  if (cv && tip && tipImg && tipCap) {
    const density = 18;
    const force = 9;
    const idle = true;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const ctx = cv.getContext('2d');
    const images = photoData.map((ph) => {
      const im = new Image();
      im.src = ph.src;
      return im;
    });
    const mouse = { x: -9999, y: -9999 };
    let w, h, cols, rows, pts, photos;
    let hovered = null;

    const init = () => {
      w = cv.clientWidth;
      h = cv.clientHeight;
      cv.width = w * dpr;
      cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = density;
      rows = Math.max(6, Math.round((density * h) / w));
      pts = [];
      for (let j = 0; j <= rows; j++)
        for (let i = 0; i <= cols; i++) {
          const hx = (i / cols) * w;
          const hy = (j / rows) * h;
          pts.push({ hx, hy, x: hx, y: hy, vx: 0, vy: 0, i, j });
        }
      photos = photoData.map((ph, k) => {
        const p = pts[Math.round(ph.fj * rows) * (cols + 1) + Math.round(ph.fi * cols)];
        p.photo = { ...ph, img: images[k] };
        return p;
      });
      hovered = null;
      tip.style.opacity = '0';
    };
    init();

    const onMove = (e) => {
      const r = cv.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
      let best = null;
      let bd = 28 * 28;
      for (const p of photos) {
        const d2 = (p.x - mouse.x) ** 2 + (p.y - mouse.y) ** 2;
        if (d2 < bd) {
          bd = d2;
          best = p;
        }
      }
      if (best !== hovered) {
        hovered = best;
        cv.parentElement.style.cursor = best ? 'pointer' : '';
        if (best) {
          if (tipImg.src !== best.photo.img.src) {
            tipImg.style.opacity = '0';
            tipImg.src = best.photo.src;
            (best.photo.img.complete ? Promise.resolve() : best.photo.img.decode().catch(() => {})).then(() => {
              tipImg.style.opacity = '1';
            });
          }
          tipCap.textContent = best.photo.cap;
          tip.style.opacity = '1';
          tip.style.transform = 'translateY(0)';
        } else {
          tip.style.opacity = '0';
          tip.style.transform = 'translateY(4px)';
        }
      }
      if (hovered) {
        const tx = Math.min(Math.max(hovered.x - 150, 8), w - 308);
        const above = hovered.y > 310;
        tip.style.left = tx + 'px';
        tip.style.top = (above ? hovered.y - 278 : hovered.y + 18) + 'px';
      }
    };
    const onLeave = () => {
      mouse.x = -9999;
      mouse.y = -9999;
      hovered = null;
      tip.style.opacity = '0';
      cv.parentElement.style.cursor = '';
    };
    cv.parentElement.addEventListener('mousemove', onMove);
    cv.parentElement.addEventListener('mouseleave', onLeave);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(init, 150);
    });

    let t = 0;
    const P = (i, j) => pts[j * (cols + 1) + i];
    const step = () => {
      t++;
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        const wob = idle ? Math.sin(t * 0.012 + p.i * 0.7 + p.j * 1.3) * 1.4 : 0;
        let fx = (p.hx - p.x) * 0.045;
        let fy = (p.hy + wob - p.y) * 0.045;
        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const d2 = dx * dx + dy * dy;
        const r = 220;
        if (d2 < r * r && d2 > 0.01) {
          const d = Math.sqrt(d2);
          const f = ((1 - d / r) * force) / Math.max(d, 30);
          fx += dx * f * 0.12;
          fy += dy * f * 0.12;
        }
        p.vx = (p.vx + fx) * 0.86;
        p.vy = (p.vy + fy) * 0.86;
        p.x += p.vx;
        p.y += p.vy;
      }
      ctx.lineWidth = 1;
      for (let j = 0; j <= rows; j++)
        for (let i = 0; i <= cols; i++) {
          const a = P(i, j);
          const al = 0.09 + Math.min(0.5, Math.hypot(a.x - a.hx, a.y - a.hy) / 30);
          ctx.strokeStyle = 'rgba(110,231,220,' + al + ')';
          if (i < cols) {
            const b = P(i + 1, j);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
          if (j < rows) {
            const c = P(i, j + 1);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(c.x, c.y);
            ctx.stroke();
          }
        }
      for (const p of pts) {
        const disp = Math.hypot(p.x - p.hx, p.y - p.hy);
        if (p.photo) {
          const pulse = 1 + Math.sin(t * 0.05) * 0.25;
          const hot = p === hovered;
          ctx.fillStyle = 'rgba(255,107,107,' + (hot ? 0.25 : 0.14) + ')';
          ctx.beginPath();
          ctx.arc(p.x, p.y, (hot ? 14 : 10) * pulse, 0, 6.2832);
          ctx.fill();
          ctx.fillStyle = hot ? '#ff8f8f' : '#ff6b6b';
          ctx.beginPath();
          ctx.arc(p.x, p.y, hot ? 5 : 3.6, 0, 6.2832);
          ctx.fill();
        } else {
          ctx.fillStyle = 'rgba(110,231,220,' + (0.3 + Math.min(0.65, disp / 20)) + ')';
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.2 + Math.min(2.4, disp / 8), 0, 6.2832);
          ctx.fill();
        }
      }
      requestAnimationFrame(step);
    };
    step();
  }
</script>
