---
import { siteData } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  showCv?: boolean;
  spaced?: boolean;
}

const { showCv = false, spaced = false } = Astro.props;
---

<footer class={`footer${spaced ? ' mt72' : ''}`}>
  <div class="container footer-inner">
    <p>© 2026 samet kocbay · munich</p>
    <div class="footer-links">
      <a href={siteData.githubUrl}>github</a>
      <a href={siteData.linkedinUrl}>linkedin</a>
      <a href={`mailto:${siteData.email}`}>email</a>
      {showCv && <a href={withBase(siteData.cvPath)} class="cv">cv.pdf ↓</a>}
    </div>
  </div>
</footer>
