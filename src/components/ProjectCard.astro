---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/withBase';

interface Props {
  project: CollectionEntry<'projects'>;
  variant: 'home' | 'list';
}

const { project, variant } = Astro.props;
const { title, year, tagline, cardSlug, summary, description, tags, image } = project.data;
const href = withBase(`/projects/${project.slug}/`);
const bg = `background-image:url('${withBase(image)}')`;
---

<a href={href} class="pcard" data-card data-tags={tags.join(',')}>
  <div class={`pcard-media${variant === 'list' ? ' tall' : ''}`}>
    <div class="bg" style={bg}></div>
    {variant === 'list' && <span class="pcard-year">{year}</span>}
  </div>
  <div class="pcard-body">
    {variant === 'home' && <p class="pcard-meta">[{year}] {tagline}</p>}
    <h3 class={`pcard-title${variant === 'list' ? ' mt0' : ''}`}>{title}</h3>
    <p class="pcard-desc">{variant === 'home' ? summary : description}</p>
    {variant === 'home' ? (
      <p class="pcard-foot">cat {cardSlug}.md →</p>
    ) : (
      <div class="pcard-tags">
        {tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
